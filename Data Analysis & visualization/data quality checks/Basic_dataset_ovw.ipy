import pandas as pd
import numpy as np
import seaborn as sns   

df = pd.read_csv('data quality checks/titanic.csv')

# print(df.describe)

#! Missing Values Analysis

missing_count = df.isna().sum().sort_values(ascending=False)
missing_percent = (df.isna().mean()*100).sort_values(ascending=False)

missing_analysis = pd.DataFrame({
    "missing_count": missing_count,
    'missing_percent': missing_percent}
)
# print(missing_analysis)

#? Duplicates

duplicates_mask = df.duplicated()
num_duplicates = duplicates_mask.sum()
#? if u want to drop the dupli {...no_dupli = df.drop_dupli()...}
# print("The number of duplicates are",num_duplicates)

#* Data Type Validation

expected_types = {
    "survived":"int64",
    "pclass":"int64",
    "sex":"category",
    "fare":"float64"
}

# print("Data Type Validation")

for col, expected in expected_types.items():
    if col in df.columns:
        actual = df[col].dtype
        print(f"{col}: actual={actual}, expected={expected}")


# Quasi-Constant columns

n_rows = len(df)
nunique = df.nunique()

constant_cols = nunique[nunique== 3].index.to_list()
# print('Const columns',constant_cols)

quasi_constant_cols = []

for col in df.columns:
    top_freq = df[col].value_counts(normalize=True,dropna=False).values[0]
    if top_freq> 0.95 and col not in constant_cols:
        quasi_constant_cols.append(col)

# print("Quasi Constant columns (top values ore than 95%)",quasi_constant_cols)
# print(df['Survived'].value_counts(normalize=True).values[0])

#* ID like columns

n_rows = len(df)
id_like_cols = []

for col in df.columns:
    if df[col].nunique(dropna=False) == n_rows:
        id_like_cols.append(col)

print("Id like columns", id_like_cols)